# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# open-next build output
/.open-next/

# cdk / infra
infra/node_modules/
infra/cdk.out/
infra/*.js
infra/*.d.ts
!infra/cdk.json

# aws credentials (never commit)
.aws/
**/aws-exports.js

# local claude settings (machine-specific)
.claude/settings.local.json
