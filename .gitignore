# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies — hoisted to the workspace root; ignore at any depth.
node_modules/

# Build output (packages/web/.next, packages/web/.open-next, packages/cdk/cdk.out)
.next/
.open-next/
out/
build/
cdk.out/
*.tsbuildinfo
next-env.d.ts

# Test coverage
coverage/

# Env files (opt in per file if one ever needs committing)
.env*

# Editor / OS
.DS_Store
*.pem

# Debug logs
npm-debug.log*
.pnpm-debug.log*

# Deploy platforms
.vercel

# AWS credentials — never commit
.aws/
**/aws-exports.js

# Claude Code local config (machine-specific)
.claude/
