{
  "name": "@dakotajp/cdk",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "cdk-app": "src/main.ts"
  },
  "scripts": {
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "test": "jest"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1094.0",
    "@aws-sdk/client-dynamodb": "^3.1094.0",
    "@aws-sdk/lib-dynamodb": "^3.1094.0",
    "aws-cdk-lib": "^2.170.0",
    "cdk-nextjs-standalone": "^4.3.3",
    "constructs": "^10.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/src/**/*.spec.ts"],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        { "tsconfig": { "module": "commonjs", "moduleResolution": "node" } }
      ]
    },
    "reporters": ["default", "github-actions"]
  }
}
