{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // aws-cdk-lib and constructs are published for NodeNext resolution; the CDK
    // toolchain expects it.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitReturns": true,
    "strictPropertyInitialization": false,
    // ts-node runs this app in-process (see cdk.json) — inline maps give real
    // line numbers in synth/deploy stack traces.
    "inlineSourceMap": true,
    "inlineSources": true,
    "types": ["jest", "node", "aws-lambda"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "cdk.out"]
}
