{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // module/moduleResolution come from the base (NodeNext), which is what the
    // CDK toolchain expects anyway.
    "noImplicitReturns": true,
    "strictPropertyInitialization": false,
    // ts-node runs this app in-process (see cdk.json) — inline maps give real
    // line numbers in synth/deploy stack traces.
    "inlineSourceMap": true,
    "inlineSources": true,
    "types": ["jest", "node", "aws-lambda"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "cdk.out"]
}
